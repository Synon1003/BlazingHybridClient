<div class="row">
    <div class="col-12">
        @if(!RequestSent)
        {
            <div class="d-flex flex-column align-items-center">
                <h6 class="fw-normal mt-5">Send the request to see the response</h6>
                <div><svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#8c8686" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-cloud-upload-icon lucide-cloud-upload"><path d="M12 13v8"/><path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"/><path d="m8 17 4-4 4 4"/></svg></div>
            </div>
        }
        else
        {
            <pre class="w-100 h-100 p-3">@ResponseText</pre>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public string? ResponseText {get;set;}

    [Parameter, EditorRequired]
    public bool RequestSent {get;set;}
}
