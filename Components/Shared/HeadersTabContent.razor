@inject AppState AppState

<span class="text-white-50 d-block">Request Headers</span>
<ul class="m-0 p-0">
    @for (var idx=0; idx<_headers.Count; idx++)
    {
        var header = _headers[idx];
        <li class="d-flex gap-1 my-2">
            <input type="text" @bind="header.Key" placeholder="Key" class="form-control bg-black text-white-50 border-dark ph-gray" />
            <input type="text" @bind="header.Value" placeholder="Value" class="form-control bg-black text-white-50 border-dark ph-gray" />
            <button type="button" 
                    class="btn btn-sm btn-default" 
                    @onclick="() => DeleteHeader(header)">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ff0000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2-icon lucide-trash-2"><path d="M10 11v6"/><path d="M14 11v6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            </button>
        </li>
    }
</ul>

<div class="d-flex align-items-center w-100">
    <hr class="bg-black" style="width: calc(50% - 50px); height: 2px" />
    <button type="button" 
            class="btn btn-sm btn-outline-dark text-white" 
            style="width: 100px;" 
            @onclick="AddHeader">
        + Add
    </button>
    <hr class="bg-black" style="width: calc(50% - 50px); height: 2px" />
</div>

@code {
    [Parameter, EditorRequired]
    public RequestModel SelectedRequest {get;set;}
    private List<KeyValueModel> _headers = [new()];
    private void AddHeader() => _headers.Add(new());
    private void DeleteHeader(KeyValueModel header) => _headers.Remove(header);
    protected override void OnInitialized()
    {
        AppState.SetRequestHeadersValueGetter(() => 
            _headers.Where(h => !string.IsNullOrWhiteSpace(h.Key)).ToList());
    }
    private int _prevId;
    protected override void OnParametersSet()
    {
        if (_prevId != SelectedRequest.Id)
        {
            _prevId = SelectedRequest.Id;
            _headers = [.. SelectedRequest.Headers, new()];
        }
    }
}