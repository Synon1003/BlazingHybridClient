<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BlazingHybridClient"
             xmlns:components="clr-namespace:BlazingHybridClient.Components"
             x:Class="BlazingHybridClient.MainPage"
             x:DataType="local:AppState">

    <Grid>
        <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html">
            <BlazorWebView.RootComponents>
                <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
            </BlazorWebView.RootComponents>
        </BlazorWebView>
        <ActivityIndicator IsRunning="{Binding ShowLoader}"
                           HorizontalOptions="Center" 
                           VerticalOptions="Center"
                           Color="Red"
                           WidthRequest="50"
                           HeightRequest="50" />
    </Grid>

</ContentPage>
